/* ---------------------------------------------------------------------
   1. RAW TABLE
   Column names/types mirror the source file exactly. Two metadata
   columns are added to track ingestion (never touch source data).
   --------------------------------------------------------------------- */

 ---Drop and recreate to fix schema
IF OBJECT_ID('Bronze.Customer_Complaints_Raw', 'U') IS NOT NULL
    DROP TABLE Bronze.Customer_Complaints_Raw;

CREATE TABLE Bronze.Customer_Complaints_Raw (
	complaint_id                    INT,
    submitted_via                   NVARCHAR(50),
    date_submitted                  DATE,
    date_received                   DATE,
    state                           NVARCHAR(10),
    product                         NVARCHAR(200),
    sub_product                     NVARCHAR(200),
    issue                           NVARCHAR(300),
    sub_issue                       NVARCHAR(300),
    company_public_response         NVARCHAR(500),
    company_response_to_consumer    NVARCHAR(100),
    timely_response                 NVARCHAR(10),
);
GO

/* 
==================================
Loading Datasets into the tables
==================================

CREATING STORED PROCEDURE*/

CREATE or ALTER PROCEDURE Bronze.Load_Bronzelayer 
AS
DECLARE @Start_Time DATETIME, @End_Time DATETIME, @Batch_Start_Time DATETIME, @Batch_End_Time DATETIME; --------- This is to declare variables @Start_Time and @End_Time to calculate duration
BEGIN
    
    BEGIN TRY ------------- To check for errors running the script
    SET @Batch_Start_Time = GETDATE()
    PRINT'==========================================================='
    PRINT'Loading Bronze Layer';
    PRINT'==========================================================='

    PRINT'-----------------------------------------------------------'
    PRINT'Loading Bronze.Customer_Complaints_Raw Tables';
    PRINT'-----------------------------------------------------------'

    SET @Start_Time = GETDATE();

    PRINT'>>>Truncating Table: Bronze.Customer_Complaints_Raw';

    TRUNCATE TABLE Bronze.Customer_Complaints_Raw;

    BULK INSERT Bronze.Customer_Complaints_Raw
    FROM 'C:\Users\MSI\Desktop\data analysis\Customer Complaintss\Customer_Complaints.csv'
    WITH
    (FORMAT = 'CSV',
    FIRSTROW = 2,  -- skip the header row
    FIELDQUOTE = '"',  -- respect quoted fields (handles embedded commas)
    FIELDTERMINATOR = ',',
    ROWTERMINATOR = '0x0d0a',
    CODEPAGE = '65001',
    TABLOCK,
    KEEPNULLS,
    MAXERRORS = 50   -- fail the batch only if more than 50 rows error out          
    ); 

    
        SET @End_Time = GETDATE();
        PRINT'>>---------------------------------------------------------------------------------------'
        PRINT'>> load Duration:' + CAST(DATEDIFF(second,@Start_Time,@End_Time) AS NVARCHAR) + ' seconds'
        PRINT'>> --------------------------------------------------------------------------------------'
        PRINT'>> ---------------------------------------------------------'
            SET @Batch_End_Time = GETDATE();
            PRINT'==========================================================================================================='
            PRINT' ------ Batch loading completed-----------------'
            PRINT'>> Batch load Duration:' + CAST(DATEDIFF(second,@Batch_Start_Time,@Batch_End_Time) AS NVARCHAR) + ' seconds'
            PRINT'==========================================================================================================='
            END TRY
            BEGIN CATCH
            PRINT'==========================================================================================================='
            PRINT'Error occured during loading Bronze'
            PRINT'Error Message' + CAST(Error_Number () AS NVARCHAR) ------------------ casting to convert interger to string
            PRINT'==========================================================================================================='
END CATCH   
END;

EXEC Bronze.Load_Bronzelayer;



