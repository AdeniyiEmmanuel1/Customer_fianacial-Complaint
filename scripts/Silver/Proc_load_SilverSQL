/* =====================================================================
   SILVER LAYER
   Project : Bank of America Consumer Complaints (CFPB, 2017-2023)
   Purpose : Explore, clean, standardize, normalize, and enrich the
             Bronze data. Every column here is either a cleaned source
             column or a derived column that feeds a Gold-layer answer.
   ===================================================================== */

-----To Create a Data Structure
USE Customer_Complaints;
GO

CREATE OR ALTER PROCEDURE Silver.load_Silver_Customer_Complaints
AS
BEGIN
    DECLARE @Start_Time DATETIME, 
            @End_Time DATETIME, 
            @Batch_Start_Time DATETIME, 
            @Batch_End_Time DATETIME;

    BEGIN TRY
        SET @Batch_Start_Time = GETDATE();
        PRINT '=================================================================================================';
        PRINT 'Loading Silver Layer';
        PRINT '=================================================================================================';

        -- =========================================================================
        -- 1. LOAD SILVER.HIMALAYAN_EXPED
        -- =========================================================================
 
INSERT INTO Silver.Customer_Complaints_Raw (
    complaint_id,
    submitted_via,
    date_submitted,                 
    date_received,                  
    state_code,                     
    product,                    
    sub_product,                   
    issue,                          
    sub_issue,                      
    company_public_response,       
    company_response_to_consumer,   
    timely_response,               
    product_category,              
    sub_product_category,         
    issue_category,                 
    sub_issue_category,             
    is_timely_response,           
    has_public_response,           
    resolution_category,           
    response_lag_days,              
    submission_year,               
    submission_month,                   
    submission_month_name,          
    submission_quarter,                 
    submission_day_of_week,         
    submission_year_month,          
    us_region                    
)
SELECT
    complaint_id,
    TRIM(submitted_via),
    date_submitted,
    date_received,
    UPPER(TRIM(state)) state_code,
    TRIM(product),
    COALESCE(NULLIF(TRIM(sub_product), ''), 'Not Specified'),
    TRIM(issue),
    COALESCE(NULLIF(TRIM(sub_issue), ''), 'Not Specified'),
    COALESCE(NULLIF(TRIM(company_public_response), ''), 'No Public Response'),
    TRIM(company_response_to_consumer),
    COALESCE(TRIM(timely_response), 'Pending'),
    ----Handling atomicity in product
    CASE
        WHEN product = 'Debt collection' THEN 'Debt Collection'
        WHEN product = 'Mortgage'        THEN 'Mortgage'
        WHEN product = 'Student loan'    THEN 'Student Loan'
        WHEN product = 'Checking or savings account' THEN
            CASE
                WHEN sub_product = 'Checking account'               THEN 'Checking Account'
                WHEN sub_product = 'Savings account'                THEN 'Savings Account'
                WHEN sub_product = 'CD (Certificate of Deposit)'    THEN 'Certificate of Deposit'
                ELSE 'Other Banking Product'
            END
        WHEN product = 'Credit card or prepaid card' THEN
            CASE
                WHEN sub_product LIKE '%credit card%'               THEN 'Credit Card'
                WHEN sub_product IN ('General-purpose prepaid card','Gift card',
                                      'Payroll card','Government benefit card')
                                                                      THEN 'Prepaid Card'
                ELSE 'Credit or Prepaid Card (Other)'
            END
        WHEN product = 'Payday loan, title loan, or personal loan' THEN
            CASE
                WHEN sub_product IN ('Payday loan','Payday loan debt')     THEN 'Payday Loan'
                WHEN sub_product = 'Title loan'                            THEN 'Title Loan'
                WHEN sub_product IN ('Personal line of credit','Installment loan')
                                                                             THEN 'Personal Loan'
                ELSE 'Payday/Title/Personal Loan (Other)'
            END
        WHEN product = 'Money transfer, virtual currency, or money service' THEN
            CASE
                WHEN sub_product LIKE '%money transfer%'            THEN 'Money Transfer'
                WHEN sub_product = 'Virtual currency'                THEN 'Virtual Currency'
                ELSE 'Money Service (Other)'
            END
        WHEN product = 'Credit reporting, credit repair services, or other personal consumer reports' THEN
            CASE
                WHEN sub_product = 'Credit reporting'                THEN 'Credit Reporting'
                WHEN sub_product = 'Credit repair services'          THEN 'Credit Repair'
                ELSE 'Other Personal Consumer Report'
            END
        WHEN product = 'Vehicle loan or lease' THEN
            CASE
                WHEN sub_product = 'Lease' THEN 'Vehicle Lease'
                ELSE 'Vehicle Loan'
            END
        ELSE TRIM(product)
    END as product_category, 
    CASE
        WHEN sub_product IS NULL OR TRIM(sub_product) IN ('', 'Not Specified', 'I do not know') THEN 'Not Specified'
        WHEN TRIM(sub_product) LIKE '%Home equity loan%'                  THEN 'Home Equity Loan/Line of Credit'
        WHEN TRIM(sub_product) = 'CD (Certificate of Deposit)'            THEN 'Certificate of Deposit'
        WHEN TRIM(sub_product) LIKE '%General-purpose credit card%'       THEN 'General Purpose Credit Card'
        WHEN TRIM(sub_product) LIKE '%Mobile or digital wallet%'          THEN 'Digital Wallet'
        WHEN TRIM(sub_product) LIKE '%Other banking product or service%' THEN 'Other Banking Product'
        ELSE TRIM(sub_product)
    END as sub_product_category,
    ----Handling atomicity in issue 
    CASE
        WHEN TRIM(issue) LIKE '%Incorrect information%'
          OR TRIM(issue) LIKE '%False statements%'
          OR TRIM(issue) LIKE '%Improper use%'                            THEN 'Incorrect / Misleading Information'
        WHEN TRIM(issue) LIKE '%Closing%'
          OR TRIM(issue) LIKE '%Opening%'
          OR TRIM(issue) LIKE '%Getting%'
          OR TRIM(issue) LIKE '%Applying%'                                THEN 'Account Opening, Closing & Servicing'
        WHEN TRIM(issue) LIKE '%Fees%'
          OR TRIM(issue) LIKE '%interest%'
          OR TRIM(issue) LIKE '%charged%'                                 THEN 'Fees & Interest Rates'
        WHEN TRIM(issue) LIKE '%Fraud%'
          OR TRIM(issue) LIKE '%scam%'
          OR TRIM(issue) LIKE '%identity theft%'                          THEN 'Fraud & Security'
        WHEN TRIM(issue) LIKE '%investigation%'
          OR TRIM(issue) LIKE '%dispute%'                                 THEN 'Dispute & Investigation'
        WHEN TRIM(issue) LIKE '%Struggling to%pay%'                       THEN 'Payment & Collection Issues'
        WHEN TRIM(issue) LIKE '%payment%'                                 THEN 'Payment & Collection Issues'
        WHEN TRIM(issue) LIKE '%overdraft%'                               THEN 'Account Features & Add-ons'
        ELSE TRIM(issue)
    END issue_category,
    CASE
        WHEN sub_issue IS NULL OR TRIM(Sub_Issue) IN ('', 'Not Specified') THEN 'Not Specified'
        WHEN sub_issue LIKE '%incorrect%'
          OR sub_issue LIKE '%wrong%'                                     THEN 'Incorrect Information'
        WHEN sub_issue LIKE '%fraud%'
          OR sub_issue LIKE '%identity theft%'                            THEN 'Fraud & Identity Theft'
        WHEN sub_issue LIKE '%fee%'
          OR sub_issue LIKE '%charge%'                                    THEN 'Fees & Overcharges'
        WHEN sub_issue LIKE '%dispute%'
          OR sub_issue LIKE '%investigation%'                             THEN 'Disputes & Claims'
        WHEN sub_issue LIKE '%payment%'
          OR sub_issue LIKE '%withdrawal%'                                THEN 'Payments & Transfers'
        WHEN sub_issue LIKE '%close%'
          OR sub_issue LIKE '%cancel%'                                    THEN 'Account Closure & Cancellation'
        ELSE TRIM(sub_issue)
    END sub_issue_category,
   CASE 
       WHEN UPPER(TRIM(timely_response)) = 'YES' THEN 1 
       ELSE 0 
   END AS is_timely_response, ---- changing timely_response to bit
   CASE 
        WHEN company_public_response IS NOT NULL THEN 1 ELSE 0 
   END has_public_response, ---- changing company_public_response to bit
   CASE
        WHEN company_response_to_consumer = 'Closed with monetary relief'      THEN 'Monetary Relief'
        WHEN company_response_to_consumer = 'Closed with non-monetary relief'  THEN 'Non-Monetary Relief'
        WHEN company_response_to_consumer = 'Closed with explanation'          THEN 'Explanation Only'
        WHEN company_response_to_consumer = 'In progress'                     THEN 'In Progress'
        WHEN company_response_to_consumer = 'Closed'                          THEN 'Unresolved'  -- no relief detail given
        ELSE 'Unresolved'
    END resolution_category,
    DATEDIFF(DAY, date_submitted, date_received) response_lag_days,
    YEAR(date_submitted) submission_year,
    MONTH(date_submitted) submission_month,
    DATENAME(MONTH, date_submitted) submission_month_name,
    'Q' + CAST(DATEPART(QUARTER, date_submitted) AS CHAR(1)) submission_quarter,
    DATENAME(WEEKDAY, date_submitted) submission_day_of_week,
    FORMAT(date_submitted, 'yyyy-MM') submission_year_month,

    CASE
        WHEN state IN ('CT','ME','MA','NH','RI','VT','NJ','NY','PA')                                             THEN 'Northeast'
        WHEN state IN ('IL','IN','MI','OH','WI','IA','KS','MN','MO','NE','ND','SD')                              THEN 'Midwest'
        WHEN state IN ('DE','DC','FL','GA','MD','NC','SC','VA','WV','AL','KY','MS','TN','AR','LA','OK','TX')     THEN 'South'
        WHEN state IN ('AZ','CO','ID','MT','NV','NM','UT','WY','AK','CA','HI','OR','WA')                         THEN 'West'
        ELSE 'Unknown'
    END us_region
FROM Bronze.Customer_Complaints_Raw;
    SET @End_Time = GETDATE();
    PRINT'>>---------------------------------------------------------------------------------------'
    PRINT'>> load Duration:' + CAST(DATEDIFF(second,@Start_Time,@End_Time) AS NVARCHAR) + ' seconds'
    PRINT'>> --------------------------------------------------------------------------------------'
    PRINT'>> ---------------------------------------------------------'
    SET @Batch_End_Time = GETDATE();
    PRINT'==========================================================================================================='
    PRINT' ------ Batch loading completed-----------------'
    PRINT'>> Batch load Duration:' + CAST(DATEDIFF(second,@Batch_Start_Time,@Batch_End_Time) AS NVARCHAR) + ' seconds'
    PRINT'==========================================================================================================='
    END TRY
    BEGIN CATCH
    PRINT'==========================================================================================================='
    PRINT'Error occured during loading Silver'
    PRINT'Error Message' + CAST(Error_Number () AS NVARCHAR) ------------------ casting to convert interger to string
    PRINT'==========================================================================================================='
END CATCH   
END;
